{
	"name": "blog",
	"compatibility_date": "2025-12-17",
	"main": "./index.js",
	"vars": {
		"SUPABASE_URL": "YOUR_SUPABASE_URL",
		"SUPABASE_ANON_KEY": "YOUR_SUPABASE_ANON_KEY"
	},
	"assets": {
		"directory": "../static/_site",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1
		}
	}
}